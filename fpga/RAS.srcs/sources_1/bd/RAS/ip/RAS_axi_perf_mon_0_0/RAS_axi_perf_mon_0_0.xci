                "Control_Register": {
                  "address_offset": "0x0300",
                  "size": 32,
                  "display_name": "Control Register",
                  "description": "Control Register",
                  "is_volatile": true,
                  "access": "read-write",
                  "reset_value": "0x0",
                  "fields": {
                    "Metrics_Cnt_EN": {
                      "bit_offset": 0,
                      "bit_width": 1,
                      "display_name": "Metrics_Cnt_EN",
                      "description": "1 - Enables all metric counters in the monitor\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Metrics_Cnt_Reset": {
                      "bit_offset": 1,
                      "bit_width": 1,
                      "display_name": "Metrics_Cnt_Reset",
                      "description": "1 - Resets all metric counters and sampled metric counters in the monitor\nNote: De-assertion of metric reset (asserted though Control register) takes five clock cycles by core.\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Use_Ext_Trig": {
                      "bit_offset": 2,
                      "bit_width": 1,
                      "display_name": "Use_Ext_Trig",
                      "description": "1 - Uses the external trigger to start the metric counters\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Enable_ID_Based_Filtering_Masking": {
                      "bit_offset": 3,
                      "bit_width": 1,
                      "display_name": "Enable_ID_Based_Filtering_Masking",
                      "description": "This bit is only valid in Advanced mode.   0 - Ignore ID for metric calculation   1 - Enables ID filtering and masking.  When enabled, all metric corresponds to the ID configured in the IDR and IDMR registers.\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Write_Latency_Start_Point": {
                      "bit_offset": 4,
                      "bit_width": 1,
                      "display_name": "Write_Latency_Start_Point",
                      "description": "0 - Enables address issuance by master interface as write latency start point (AWVALID)\n1 - Enables address acceptance by the slave interface as write latency start point (AWVALID and AWREADY)\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Write_Latency_End_Point": {
                      "bit_offset": 5,
                      "bit_width": 1,
                      "display_name": "Write_Latency_End_Point",
                      "description": "1 - Enables first write as write latency end point\n0 - Enables Last write as write latency end point\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Read_Latency_Start_Point": {
                      "bit_offset": 6,
                      "bit_width": 1,
                      "display_name": "Read_Latency_Start_Point",
                      "description": "0 - Enables address issuance by the master interface as read latency start point (ARVALID)\n1 - Enables address acceptance by slave as read latency start\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Read_Latency_End_Point": {
                      "bit_offset": 7,
                      "bit_width": 1,
                      "display_name": "Read_Latency_End_Point",
                      "description": "1 - Enables first read as read latency end point\n0 - Enables last read as read latency end point\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Enable_Event_Log": {
                      "bit_offset": 8,
                      "bit_width": 1,
                      "display_name": "Enable_Event_Log",
                      "description": "1 - Enables event logging\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Use_Ext_Trig_Log": {
                      "bit_offset": 9,
                      "bit_width": 1,
                      "display_name": "Use_Ext_Trig_Log",
                      "description": "1 - Uses the external trigger to start the event log\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Global_Clk_Cnt_En": {
                      "bit_offset": 16,
                      "bit_width": 1,
                      "display_name": "Global_Clk_Cnt_En",
                      "description": "1 - Enables the free-running Global Clock Counter. Advanced mode only.\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Global_Clk_Cnt_Reset": {
                      "bit_offset": 17,
                      "bit_width": 1,
                      "display_name": "Global_Clk_Cnt_Reset",
                      "description": "1 - Resets the free-running Global Clock Counter. Advanced mode only.\n",
                      "is_volatile": true,
                      "access": "read-write"
                    },
                    "Streaming_FIFO_Reset": {
                      "bit_offset": 25,
                      "bit_width": 1,
                      "display_name": "Streaming_FIFO_Reset",
                      "description": "1 - Resets the streaming FIFO When the trigger parameter (C_EN_TRIGGER) is asserted, the same bit is also used to reset the complete trigger path logic.\n",
                      "is_volatile": true,
                      "access": "read-write"
                    }
                  }
                },
